{
  "version": 8,
  "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/ports",
        "NX_BUILD_TESTS": "ON",
        "NX_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-nx",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      }
    },
    {
      "name": "dev-windows-msvc",
      "displayName": "Windows · MSVC · Debug",
      "inherits": "windows-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "dev-windows-clang",
      "displayName": "Windows · Clang · Debug",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-windows-msvc",
      "displayName": "Windows · MSVC · Release",
      "inherits": "windows-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "fuzz-windows-msvc",
      "displayName": "Windows · MSVC · libFuzzer + AddressSanitizer",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NX_BUILD_TESTS": "OFF",
        "NX_BUILD_BENCHMARKS": "OFF",
        "NX_BUILD_TOOLS": "OFF",
        "NX_BUILD_CLIENT": "OFF",
        "NX_FUZZ": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-nx-asan",
        "CMAKE_CXX_FLAGS": "/fsanitize=address /fsanitize=fuzzer"
      }
    },
    {
      "name": "tools-windows-msvc",
      "displayName": "Windows · MSVC · Tools",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NX_BUILD_TESTS": "OFF",
        "NX_BUILD_BENCHMARKS": "OFF",
        "NX_BUILD_CLIENT": "OFF",
        "NX_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux-nx", "VCPKG_HOST_TRIPLET": "x64-linux" }
    },
    {
      "name": "dev-linux-gcc",
      "displayName": "Linux · GCC · Debug",
      "inherits": "linux",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release-linux-gcc",
      "displayName": "Linux · GCC · Release",
      "inherits": "linux",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "tools-linux-gcc",
      "displayName": "Linux · GCC · Tools",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release",
        "NX_BUILD_TESTS": "OFF",
        "NX_BUILD_BENCHMARKS": "OFF",
        "NX_BUILD_CLIENT": "OFF",
        "NX_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "tsan-linux-gcc",
      "displayName": "Linux · GCC · ThreadSanitizer",
      "inherits": "dev-linux-gcc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "dev-linux-clang",
      "displayName": "Linux · Clang · Debug",
      "inherits": "linux",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan-linux-clang",
      "displayName": "Linux · Clang · AddressSanitizer + UBSan",
      "inherits": "dev-linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan-linux-clang",
      "displayName": "Linux · Clang · ThreadSanitizer",
      "inherits": "dev-linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-windows-clang", "configurePreset": "dev-windows-clang" },
    { "name": "dev-windows-msvc", "configurePreset": "dev-windows-msvc" },
    { "name": "release-windows-msvc", "configurePreset": "release-windows-msvc" },
    { "name": "fuzz-windows-msvc", "configurePreset": "fuzz-windows-msvc" },
    { "name": "tools-windows-msvc", "configurePreset": "tools-windows-msvc" },
    { "name": "dev-linux-gcc", "configurePreset": "dev-linux-gcc" },
    { "name": "release-linux-gcc", "configurePreset": "release-linux-gcc" },
    { "name": "tools-linux-gcc", "configurePreset": "tools-linux-gcc" },
    { "name": "tsan-linux-gcc", "configurePreset": "tsan-linux-gcc" },
    { "name": "dev-linux-clang", "configurePreset": "dev-linux-clang" },
    { "name": "asan-linux-clang", "configurePreset": "asan-linux-clang" },
    { "name": "tsan-linux-clang", "configurePreset": "tsan-linux-clang" }
  ],
  "testPresets": [
    { "name": "dev-windows-clang", "inherits": "test-base", "configurePreset": "dev-windows-clang" },
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "test-tsan",
      "hidden": true,
      "inherits": "test-base",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/tests/tsan.supp"
      }
    },
    { "name": "dev-windows-msvc", "inherits": "test-base", "configurePreset": "dev-windows-msvc" },
    { "name": "release-windows-msvc", "inherits": "test-base", "configurePreset": "release-windows-msvc" },
    { "name": "fuzz-windows-msvc", "inherits": "test-base", "configurePreset": "fuzz-windows-msvc" },
    { "name": "dev-linux-gcc", "inherits": "test-base", "configurePreset": "dev-linux-gcc" },
    { "name": "release-linux-gcc", "inherits": "test-base", "configurePreset": "release-linux-gcc" },
    { "name": "tsan-linux-gcc", "inherits": "test-tsan", "configurePreset": "tsan-linux-gcc" },
    { "name": "dev-linux-clang", "inherits": "test-base", "configurePreset": "dev-linux-clang" },
    { "name": "asan-linux-clang", "inherits": "test-base", "configurePreset": "asan-linux-clang" },
    { "name": "tsan-linux-clang", "inherits": "test-tsan", "configurePreset": "tsan-linux-clang" }
  ]
}
