# Normalize line endings in the repository; sources use LF everywhere.
* text=auto eol=lf

# Windows scripts keep CRLF so cmd.exe and PowerShell 5 read them correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary formats (GoldSrc assets used only as synthetic test fixtures).
*.bsp  binary
*.mdl  binary
*.wad  binary
*.spr  binary
*.wav  binary
*.tga  binary
*.png  binary
*.ktx2 binary
*.nxpak binary

# VGUI2's localized strings are UTF-16 with CRLF: the fuzz seed keeps them byte for byte.
tests/fuzz/corpus/keyValues/*.txt binary
