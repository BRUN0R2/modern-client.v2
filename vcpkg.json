{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "modern-client-v2",
  "version-semver": "0.1.0",
  "description": "Open-source recreation of Counter-Strike 1.6 on a modern C++26 engine",
  "builtin-baseline": "469a0504e4a6ebf6173d1c0f51a7fa34c382fd43",
  "dependencies": [
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "wayland",
          "platform": "linux"
        },
        {
          "name": "x11",
          "platform": "linux"
        }
      ]
    },
    "tomlplusplus",
    {
      "name": "freetype",
      "default-features": false
    },
    "volk",
    "vulkan-headers",
    {
      "name": "shader-slang",
      "host": true
    },
    "vulkan-memory-allocator"
  ],
  "features": {
    "tests": {
      "description": "Unit tests (GoogleTest) and reference implementations used to verify ours",
      "dependencies": [
        "gtest",
        "xxhash"
      ]
    },
    "benchmarks": {
      "description": "Benchmarks of hot paths (Google Benchmark)",
      "dependencies": [
        "benchmark"
      ]
    }
  }
}
