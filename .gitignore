# Build trees (CMake presets write to build/<preset>)
/build/
/out/
/install/

# Local agent settings and worktrees, which have their own dependencies and build output.
/.claude/

# vcpkg manifest-mode output
/vcpkg_installed/

# Local, per-developer CMake presets
CMakeUserPresets.json

# IDEs and editor caches
/.vs/
/.idea/
/.cache/
*.user
*.suo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Compiler, linker and debugger artifacts that may land outside build/
*.ifc
*.obj
*.pdb
*.ilk
*.exp

# Local content configuration and game installation links (ADR-0015). Only
# content.example.toml is versioned; content.toml points at files of this machine.
/content.toml
/cstrike/
/valve/
*.dmp
*.log

# OS noise
Thumbs.db
.DS_Store
